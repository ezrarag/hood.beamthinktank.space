# =================================================================
# HOOD DEVELOPMENT ENVIRONMENT (.env.development)
# Automatically loaded when running `npm run dev`
# =================================================================

# Firebase Client SDK Configuration (beam-hood)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=beam-hood.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=beam-hood
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=beam-hood.firebasestorage.app

# Development Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
